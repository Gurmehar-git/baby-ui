{
	"name": "@baby-ui/site",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "cross-env PORTLESS_HTTPS=0 portless",
		"dev:app": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "docvia sync && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"portless": {
		"name": "site.baby-ui",
		"script": "dev:app"
	},
	"devDependencies": {
		"@baby-ui/registry-build": "workspace:*",
		"@docvia/build": "^3.0.0",
		"@docvia/cli": "^3.0.0",
		"@sveltejs/adapter-cloudflare": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"d3-scale": "catalog:",
		"fontaine": "^1.0.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwind-variants": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"wrangler": "^4.135.0",
		"yaml": "^2.9.1"
	},
	"dependencies": {
		"@baby-ui/demos": "workspace:*",
		"@baby-ui/icons": "workspace:*",
		"@baby-ui/registry-schema": "workspace:*",
		"@baby-ui/svelte": "workspace:*",
		"@baby-ui/tokens": "workspace:*",
		"@better-svelte-email/server": "catalog:",
		"@docvia/core": "^3.0.0",
		"@fontsource-variable/inter": "catalog:",
		"@fontsource-variable/jetbrains-mono": "catalog:",
		"@fontsource-variable/newsreader": "catalog:",
		"@shikijs/langs": "catalog:",
		"@shikijs/themes": "catalog:",
		"clsx": "catalog:",
		"detype": "^2.0.8",
		"mode-watcher": "^1.1.0",
		"posthog-js": "^1.434.12",
		"shiki": "catalog:",
		"tailwind-merge": "catalog:",
		"takumi-js": "^2.14.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
