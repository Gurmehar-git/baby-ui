{
	"name": "@baby-ui/playground-shell",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "cross-env PORTLESS_HTTPS=0 portless",
		"dev:app": "vite",
		"build": "vite build",
		"check": "svelte-check --tsconfig ./tsconfig.json"
	},
	"portless": {
		"name": "shell.baby-ui",
		"script": "dev:app"
	},
	"dependencies": {
		"@baby-ui/components": "workspace:*",
		"@baby-ui/demos": "workspace:*",
		"@baby-ui/registry-schema": "workspace:*",
		"@baby-ui/tokens": "workspace:*"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
