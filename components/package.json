{
	"name": "@baby-ui/components",
	"version": "0.0.0",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./data-table/worker": "./data-table/worker.ts",
		"./react/*": "./*/react/index.ts",
		"./svelte/*": {
			"svelte": "./*/svelte/index.ts",
			"types": "./*/svelte/index.ts"
		},
		"./lib/react/*": "./lib/react/*.ts",
		"./lib/svelte/*": {
			"svelte": "./lib/svelte/*.ts",
			"types": "./lib/svelte/*.ts"
		},
		"./lib/*": "./lib/*.ts",
		"./specs": "./specs.ts"
	},
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.react.json && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test _tools"
	},
	"dependencies": {
		"@baby-ui/registry-schema": "workspace:*",
		"@base-ui/react": "catalog:",
		"@better-svelte-email/components": "catalog:",
		"@docvia/markdown": "catalog:",
		"@internationalized/date": "catalog:",
		"@tanstack/react-form": "catalog:",
		"@tanstack/store": "catalog:",
		"@tanstack/svelte-form": "catalog:",
		"@tanstack/table-core": "catalog:",
		"@tanstack/virtual-core": "catalog:",
		"bits-ui": "catalog:",
		"clsx": "catalog:",
		"cmdk": "catalog:",
		"d3-array": "catalog:",
		"d3-geo": "catalog:",
		"d3-sankey": "catalog:",
		"d3-scale": "catalog:",
		"d3-shape": "catalog:",
		"hls.js": "catalog:",
		"input-otp": "catalog:",
		"media-chrome": "catalog:",
		"react-day-picker": "catalog:",
		"react-email": "catalog:",
		"sonner": "catalog:",
		"svelte": "catalog:",
		"svelte-sonner": "catalog:",
		"swapy": "catalog:",
		"tailwind-merge": "catalog:",
		"tailwind-variants": "catalog:",
		"vaul": "catalog:",
		"vaul-svelte": "catalog:"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/d3-array": "catalog:",
		"@types/d3-geo": "catalog:",
		"@types/d3-sankey": "catalog:",
		"@types/d3-scale": "catalog:",
		"@types/d3-shape": "catalog:",
		"@types/geojson": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
