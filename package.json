{
	"name": "baby-ui",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@11.1.2",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"gen": "node scripts/generate.mjs",
		"gen:watch": "node scripts/gen-watch.mjs",
		"registry:watch": "node scripts/registry-watch.mjs",
		"emails": "node scripts/emails/render.mjs",
		"prepare": "node scripts/generate.mjs",
		"build": "turbo run build",
		"check": "node scripts/check-comments.mjs && node scripts/check-import-extensions.mjs && turbo run check",
		"component": "node scripts/create-component.mjs",
		"cover": "node scripts/generate-cover.mjs",
		"dev": "turbo run dev --filter=@baby-ui/site",
		"dev:list": "portless list",
		"dev:stop": "portless prune",
		"playground": "turbo run dev --filter=@baby-ui/playground-*",
		"registry": "node scripts/sync-fonts.mjs && turbo run registry",
		"lint": "biome check . && node scripts/check-comments.mjs && node scripts/check-import-extensions.mjs",
		"format": "biome check --write .",
		"fix": "node scripts/check-import-extensions.mjs --write && biome check --write . && node scripts/check-comments.mjs",
		"fonts": "node scripts/sync-fonts.mjs",
		"size": "node scripts/check-worker-size.mjs",
		"verify": "node scripts/verify.mjs",
		"verify:quick": "node scripts/verify.mjs --quick",
		"verify:full": "node scripts/verify.mjs --full",
		"probe": "node scripts/probe/index.mjs",
		"design:audit": "node scripts/design.mjs audit",
		"design:premium": "node scripts/design.mjs premium",
		"test": "node --test scripts/test-*.mjs skills/*/tests/*.test.mjs && pnpm --filter @baby-ui/registry-build test",
		"test:chart": "node --test scripts/test-chart-core.mjs"
	},
	"devDependencies": {
		"@better-svelte-email/server": "catalog:",
		"@biomejs/biome": "^2.5.14",
		"@types/node": "catalog:",
		"cross-env": "^10.1.0",
		"esbuild": "^0.28.2",
		"lefthook": "^2.1.16",
		"portless": "^0.15.6",
		"react": "catalog:",
		"react-dom": "catalog:",
		"takumi-js": "^2.14.0",
		"turbo": "^2.11.1",
		"typescript": "catalog:"
	}
}
