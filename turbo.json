{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"globalPassThroughEnv": ["CI", "PROBE_BROWSER"],
	"tasks": {
		"//#gen": {
			"cache": false
		},
		"//#gen:watch": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["//#gen"]
		},
		"//#registry:watch": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["@baby-ui/registry-build#registry"]
		},
		"//#fonts": {
			"inputs": ["scripts/sync-fonts.mjs", "packages/tokens/fonts/**"],
			"outputs": ["apps/*/static/fonts/**", "apps/playground/*/public/fonts/**"]
		},
		"//#emails": {
			"dependsOn": ["//#gen"],
			"env": ["BABY_UI_SITE_URL"],
			"inputs": [
				"scripts/emails/**",
				"packages/tokens/src/**",
				"components/email-*/**",
				"packages/demos/src/data/email-samples.ts",
				"pro/components/email-*/**",
				"pro/packages/demos/src/data/email-samples.ts"
			],
			"outputs": [
				"apps/site/src/lib/generated/emails/**",
				"apps/site/src/lib/generated/emails-pro/**"
			]
		},
		"build": {
			"dependsOn": ["//#gen", "//#fonts", "//#emails", "^build", "^registry"],
			"env": [
				"VITE_POSTHOG_KEY",
				"VITE_SHOW_PRO",
				"BABY_UI_REGISTRY_URL",
				"BABY_UI_SITE_URL"
			],
			"outputs": ["dist/**", ".svelte-kit/**", "build/**", ".docvia/**"]
		},
		"registry": {
			"dependsOn": ["//#gen", "^build"],
			"env": [
				"BABY_UI_REGISTRY_URL",
				"BABY_UI_SITE_URL",
				"BABY_UI_REGISTRY_OUT",
				"VITE_SHOW_PRO"
			],
			"inputs": [
				"src/**",
				"../tokens/src/**",
				"../registry-schema/src/**",
				"../../components/**",
				"../../apps/site/src/docs/**",
				"../../pro/components/**"
			],
			"outputs": [
				"../../apps/site/static/r/**",
				"../../apps/site/static/svelte/**",
				"../../apps/site/static/llms.txt",
				"../../apps/site/src/lib/generated/**",
				"../../THIRD_PARTY_LICENSES.md"
			]
		},
		"check": {
			"dependsOn": ["//#gen", "//#emails", "^build", "^registry"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["//#gen", "//#fonts", "//#emails", "^registry"],
			"with": ["//#gen:watch"]
		},
		"@baby-ui/site#build": {
			"dependsOn": ["//#gen", "//#fonts", "//#emails", "^build", "^registry"],
			"env": [
				"VITE_POSTHOG_KEY",
				"VITE_SHOW_PRO",
				"BABY_UI_REGISTRY_URL",
				"BABY_UI_SITE_URL"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"../../pro/components/**",
				"../../pro/packages/*/src/**"
			],
			"outputs": [".svelte-kit/**", "build/**", ".docvia/**"]
		},
		"@baby-ui/site#dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["//#gen", "//#fonts", "//#emails", "^registry"],
			"with": ["//#gen:watch", "//#registry:watch"]
		}
	}
}
