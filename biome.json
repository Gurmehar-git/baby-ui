{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/.svelte-kit",
			"!**/.docvia",
			"!**/dist",
			"!**/build",
			"!**/.turbo",
			"!apps/site/static",
			"!packages/icons/src/icons",
			"!packages/icons/custom",
			"!packages/icons/src/index.ts",
			"!pnpm-lock.yaml",
			"!**/*.css",
			"!.vscode"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 90
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error"
			},
			"style": {
				"useConst": "error",
				"noNonNullAssertion": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		},
		{
			"includes": ["components/*/react/**", "components/*/examples/*.tsx"],
			"linter": {
				"domains": {
					"react": "recommended"
				}
			}
		},
		{
			"includes": ["packages/demos/src/usage/react/**"],
			"linter": {
				"rules": {
					"a11y": {
						"useValidAriaRole": "off"
					}
				}
			}
		}
	]
}
