{
	"name": "@baby-ui/svelte",
	"version": "0.0.0",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./src/lib/index.ts",
	"exports": {
		".": {
			"svelte": "./src/lib/index.ts",
			"types": "./src/lib/index.ts"
		},
		"./lib/*": {
			"svelte": "./src/lib/lib/*.ts",
			"types": "./src/lib/lib/*.ts"
		},
		"./data-table/worker": {
			"types": "./src/lib/data-table/worker.ts",
			"default": "./src/lib/data-table/worker.ts"
		},
		"./*": {
			"svelte": "./src/lib/*/index.ts",
			"types": "./src/lib/*/index.ts"
		}
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@baby-ui/components": "workspace:*",
		"@better-svelte-email/components": "catalog:",
		"@docvia/markdown": "catalog:",
		"@internationalized/date": "catalog:",
		"@tanstack/store": "catalog:",
		"@tanstack/svelte-form": "catalog:",
		"@tanstack/table-core": "catalog:",
		"@tanstack/virtual-core": "catalog:",
		"bits-ui": "catalog:",
		"clsx": "catalog:",
		"d3-array": "catalog:",
		"d3-geo": "catalog:",
		"d3-sankey": "catalog:",
		"d3-scale": "catalog:",
		"d3-shape": "catalog:",
		"hls.js": "catalog:",
		"media-chrome": "catalog:",
		"svelte": "catalog:",
		"svelte-sonner": "catalog:",
		"swapy": "catalog:",
		"tailwind-merge": "catalog:",
		"tailwind-variants": "catalog:",
		"vaul-svelte": "catalog:"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/d3-array": "catalog:",
		"@types/d3-geo": "catalog:",
		"@types/d3-sankey": "catalog:",
		"@types/d3-scale": "catalog:",
		"@types/d3-shape": "catalog:",
		"@types/geojson": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
